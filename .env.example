# ローカルの開発環境の設定の見本。
# このファイルを .env にコピーし、PGPASSWORD を決めてから使う(README.md)。
# .env は、リポジトリが追跡しない。秘密を、このファイルには書かない。
#
# 値は、引用符を付けずに書く。空白と # は、使わない。
# Docker Compose と、scripts/with-env.sh の、両方が読むためである。

# 保管先(PostgreSQL)への接続情報
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=chat
PGPASSWORD=
PGDATABASE=chat

# アプリのオリジン(クライアントの開発用のサーバー)
APP_ORIGIN=http://localhost:5173

# 案内(登録の確認)を送る、SMTP のサーバーの接続先と、送信元のアドレス(ADR-018)。
# 接続先のホストは、ループバックのアドレス(127.0.0.0/8、::1)に限る。秘密ではない。
SMTP_ADDR=127.0.0.1:1025
MAIL_FROM=no-reply@chat.example

# ローカルの開発環境で、案内を受け取る Mailpit が、端末に公開するポート(compose.yaml)。
# 画面は、http://127.0.0.1:8025 で開く(localhost では、開かない。README.md)。
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# 上限(任意)。値は、回数/時間 で書く。与えない場合は、既定値で働く(下の値)。
# LIMIT_SIGNUP_REQUEST_PER_SOURCE=10/1h
# LIMIT_SIGNUP_REQUEST_PER_CONTACT=3/1h
# LIMIT_SIGNUP_COMPLETION_PER_SOURCE=20/1h
# LIMIT_LOGIN_FAILURE_PER_CONTACT=10/15m
# LIMIT_LOGIN_FAILURE_PER_SOURCE=30/15m
# LIMIT_PEER_LOOKUP_PER_USER=30/1h

# E2Eテストで使う Chromium の実行ファイルの場所(任意)。
# 与えない場合は、Playwright が取得した Chromium を使う(README.md「初回の準備」)。
# E2E_CHROMIUM_PATH=/snap/bin/chromium
