# ローカルの開発環境の設定の見本。
# このファイルを .env にコピーし、PGPASSWORD を決めてから使う(README.md)。
# .env は、リポジトリが追跡しない。秘密を、このファイルには書かない。
#
# 値は、引用符を付けずに書く。空白と # は、使わない。
# Docker Compose と、scripts/with-env.sh の、両方が読むためである。

# 保管先(PostgreSQL)への接続情報
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=chat
PGPASSWORD=
PGDATABASE=chat

# アプリのオリジン(クライアントの開発用のサーバー)
APP_ORIGIN=http://localhost:5173

# E2Eテストで使う Chromium の実行ファイルの場所(任意)。
# 与えない場合は、Playwright が取得した Chromium を使う(README.md「初回の準備」)。
# E2E_CHROMIUM_PATH=/snap/bin/chromium
